---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Contact Jack Brown at hello@jackbrown.xyz, Rockwell Hitec, or RadioForUs."
>
  <header class="page-intro">
    <h1>Contact</h1>
    <p>Open to project enquiries. Pick the address that fits, or use hello@ for anything else.</p>
  </header>

  <div class="contact-block panel">
    <div class="contact-row">
      <span>Email</span>
      <ul class="email-list">
        {
          site.emails.map((entry) => (
            <li>
              <a href={`mailto:${entry.address}`}>{entry.address}</a>
              <span class="email-label">{entry.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="contact-row">
      <span>Location</span>
      <strong>{site.location}</strong>
    </div>
    <div class="contact-row">
      <span>GitHub</span>
      <a href={site.github} rel="me noopener noreferrer">github.com/null65</a>
    </div>
    <div class="contact-row">
      <span>LinkedIn</span>
      <a href={site.linkedin} rel="me noopener noreferrer">linkedin.com/in/driverjack</a>
    </div>
  </div>
</BaseLayout>
